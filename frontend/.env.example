# Optional. Leave unset to use the defaults:
# - npm run dev: http://127.0.0.1:8000 (local backend)
# - production build (Vercel): same origin; vercel.json forwards /api/* and /health to the backend.
# Set it only to call a backend directly (that backend must then allow this origin in CORS_ORIGINS).
# VITE_API_URL=http://127.0.0.1:8000
