# Copy to backend/.env and fill in. Never commit .env.
# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=
# Any OpenAI-compatible API (Groq, or Ollama at http://127.0.0.1:11434/v1 with no key)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Order to try providers in (default gemini,openai_compat)
LLM_PROVIDERS=
# Seconds per request (default 12)
LLM_TIMEOUT_S=
# 1 = cache answers in backend/.cache/llm, 0 = off (default 1)
LLM_CACHE=
