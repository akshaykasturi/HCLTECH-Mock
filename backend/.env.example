# Copy this file to backend/.env and fill in real values. Never commit .env.
# auto = Gemini first, Groq as backup (only providers with a key are used); extractive = no LLM
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# minimal | low | medium | high; lower = faster answers. Empty = don't send it (model default)
GEMINI_THINKING_LEVEL=low
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_S=12
# seconds to skip a provider after it fails, before trying it again
LLM_COOLDOWN_S=300
CORS_ORIGINS=http://localhost:5173
# empty = local SQLite file backend/app.db; in prod set a Postgres URL (postgres:// is accepted)
DATABASE_URL=
# seconds to wait for a Postgres connection (per address) before treating the database as unavailable
DB_CONNECT_TIMEOUT_S=10
# semantic search. fastembed = real model (downloaded once into backend/.cache/fastembed);
# hash = offline bag-of-words vectors, for tests only. Each embedder needs its own
# gate.min_retrieval_strength entry in app/policy.yaml (run scripts/tune_gate.py).
EMBEDDER=fastembed
EMBED_MODEL=BAAI/bge-small-en-v1.5
